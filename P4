# AI Practical 4
# Adversarial Search using Alpha-Beta Pruning

def alpha_beta(node, depth, alpha, beta, maximizing_player):

    # Terminal node
    if isinstance(node, int):
        return node

    if maximizing_player:

        best_value = float('-inf')

        for child in node:

            value = alpha_beta(
                child,
                depth + 1,
                alpha,
                beta,
                False
            )

            best_value = max(best_value, value)

            alpha = max(alpha, best_value)

            # Alpha-Beta Pruning
            if beta <= alpha:
                print("Pruned branch at MAX node")
                break

        return best_value

    else:

        best_value = float('inf')

        for child in node:

            value = alpha_beta(
                child,
                depth + 1,
                alpha,
                beta,
                True
            )

            best_value = min(best_value, value)

            beta = min(beta, best_value)

            # Alpha-Beta Pruning
            if beta <= alpha:
                print("Pruned branch at MIN node")
                break

        return best_value


# Game Tree
game_tree = [
    [
        [3, 5],
        [6, 9]
    ],
    [
        [1, 2],
        [0, -1]
    ]
]


# Initial values
alpha = float('-inf')
beta = float('inf')

# Execute Alpha-Beta Search
optimal_value = alpha_beta(
    game_tree,
    0,
    alpha,
    beta,
    True
)

print("\nOptimal value for MAX:", optimal_value)
